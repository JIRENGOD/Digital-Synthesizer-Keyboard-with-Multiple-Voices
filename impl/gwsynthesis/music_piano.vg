    .o_i2s_lrck_d(o_i2s_lrck_d),
    .o_i2s_sdata_d(o_i2s_sdata_d),
    .sample_tick(sample_tick),
    .o_i2s_bck_d(o_i2s_bck_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top_touch_synth */
