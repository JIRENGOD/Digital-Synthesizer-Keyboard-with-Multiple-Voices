module sine_lut_2 (
  i_clk_50m_d,
  n1504_8,
  ph_rd,
  lut_q
)
;
input i_clk_50m_d;
input n1504_8;
input [31:20] ph_rd;
output [15:0] lut_q;
wire [31:4] DO;
wire [31:4] DO_0;
wire [31:4] DO_1;
wire [31:4] DO_2;
wire VCC;
wire GND;
